{
  "info": {
    "name": "AutoGest API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5001" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@autogest.com\",\n  \"password\": \"admin123\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const data = pm.response.json();",
            "if (data.token) { pm.collectionVariables.set('token', data.token); }"
          ]
        }
      }]
    },
    {
      "name": "Listar Vehículos",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/vehiculosapi?page=1&pageSize=10" }
    },
    {
      "name": "Crear Vehículo (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/vehiculosapi",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patente\": \"ZZ999ZZ\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2022,\n  \"kilometraje\": 15000,\n  \"color\": \"Rojo\",\n  \"clienteId\": 1\n}"
        }
      }
    }
  ]
}