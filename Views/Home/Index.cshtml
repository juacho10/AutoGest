@{
    ViewData["Title"] = "AutoGest - Inicio";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 text-dark">🔧 AutoGest</h1>
        <p class="lead text-muted">Sistema de Gestión para Talleres Mecánicos</p>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x text-primary mb-3"></i>
                    <h5>Clientes</h5>
                    <p>Gestione clientes y sus datos de contacto</p>
                    <a href="@Url.Action("Index", "Clientes")" class="btn btn-primary w-100">Ver Clientes</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-clipboard-list fa-3x text-success mb-3"></i>
                    <h5>Órdenes de Reparación</h5>
                    <p>Administre órdenes y asignación de mecánicos</p>
                    <a href="@Url.Action("Index", "Ordenes")" class="btn btn-success w-100">Ver Órdenes</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-boxes fa-3x text-warning mb-3"></i>
                    <h5>Repuestos</h5>
                    <p>Catálogo y stock de repuestos</p>
                    <a href="@Url.Action("Index", "Repuestos")" class="btn btn-warning w-100">Ver Repuestos</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Resumen del Sistema</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h3 class="text-primary" id="contadorClientes">0</h3>
                            <p class="text-muted">Clientes</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-success" id="contadorVehiculos">0</h3>
                            <p class="text-muted">Vehículos</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-warning" id="contadorOrdenes">0</h3>
                            <p class="text-muted">Órdenes Activas</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-info" id="contadorPagos">0</h3>
                            <p class="text-muted">Pagos</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function animarContador(el, valorFinal, duracion = 1500) {
                let v = 0;
                const inc = valorFinal / (duracion / 16);
                function paso() {
                    v += inc;
                    if (v < valorFinal) {
                        el.textContent = Math.floor(v);
                        setTimeout(paso, 16);
                    } else el.textContent = valorFinal;
                }
                paso();
            }
            animarContador(document.getElementById('contadorClientes'), @ViewBag.TotalClientes);
            animarContador(document.getElementById('contadorVehiculos'), @ViewBag.TotalVehiculos);
            animarContador(document.getElementById('contadorOrdenes'), @ViewBag.TotalOrdenes);
            animarContador(document.getElementById('contadorPagos'), @ViewBag.TotalPagos);
        });
    </script>
}