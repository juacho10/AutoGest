@model AutoGest.Models.Repuesto
@{ ViewData["Title"] = "Eliminar Repuesto"; }

<h1>🗑️ Eliminar Repuesto</h1>
<h3>¿Está seguro de que desea eliminar este repuesto?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Código</dt><dd class="col-sm-10">@Model.Codigo</dd>
        <dt class="col-sm-2">Descripción</dt><dd class="col-sm-10">@Model.Descripcion</dd>
        <dt class="col-sm-2">Stock</dt><dd class="col-sm-10">@Model.Stock</dd>
        <dt class="col-sm-2">Precio</dt><dd class="col-sm-10">$@Model.Precio.ToString("N2")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>