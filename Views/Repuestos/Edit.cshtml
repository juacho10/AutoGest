@model AutoGest.Models.Repuesto
@{ ViewData["Title"] = "Editar Repuesto"; }

<h1>✏️ Editar Repuesto</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaCreacion" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Codigo" class="form-label">Código *</label>
                <input asp-for="Codigo" class="form-control" maxlength="30" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción *</label>
                <input asp-for="Descripcion" class="form-control" maxlength="200" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Proveedor" class="form-label">Proveedor</label>
                <input asp-for="Proveedor" class="form-control" maxlength="100" />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Stock" class="form-label">Stock *</label>
                        <input asp-for="Stock" type="number" min="0" class="form-control" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Precio" class="form-label">Precio *</label>
                        <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Precio" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label">Activo</label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}