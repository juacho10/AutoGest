@model AutoGest.Models.Repuesto
@{ ViewData["Title"] = "Detalles del Repuesto"; }

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title mb-0">📦 Detalles del Repuesto</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt><dd class="col-sm-8">@Model.Id</dd>
                        <dt class="col-sm-4">Código:</dt><dd class="col-sm-8"><strong>@Model.Codigo</strong></dd>
                        <dt class="col-sm-4">Descripción:</dt><dd class="col-sm-8">@Model.Descripcion</dd>
                        <dt class="col-sm-4">Proveedor:</dt><dd class="col-sm-8">@(Model.Proveedor ?? "No especificado")</dd>
                        <dt class="col-sm-4">Stock:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Stock <= 5)
                            {
                                <span class="badge bg-danger">@Model.Stock - Stock bajo</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Model.Stock</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Precio:</dt><dd class="col-sm-8">$@Model.Precio.ToString("N2")</dd>
                        <dt class="col-sm-4">Fecha Creación:</dt><dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">✏️ Editar</a>
                    <a asp-action="Index" class="btn btn-secondary">📋 Volver</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">🗑️ Eliminar</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>