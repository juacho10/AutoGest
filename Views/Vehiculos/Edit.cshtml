@model AutoGest.Models.Vehiculo
@{ ViewData["Title"] = "Editar Vehículo"; }

<h1>✏️ Editar Vehículo</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FechaCreacion" />
            <input type="hidden" asp-for="Imagen" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Patente" class="form-label">Patente *</label>
                        <input asp-for="Patente" class="form-control" maxlength="10" />
                        <span asp-validation-for="Patente" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="ClienteId" class="form-label">Cliente *</label>
                        <select asp-for="ClienteId" class="form-select" id="clienteSelect">
                            @if (Model.Cliente != null)
                            {
                                <option value="@Model.Cliente.Id" selected>@Model.Cliente.NombreCompleto - DNI @Model.Cliente.Dni</option>
                            }
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Marca" class="form-label">Marca *</label>
                        <input asp-for="Marca" class="form-control" maxlength="50" />
                        <span asp-validation-for="Marca" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Modelo" class="form-label">Modelo *</label>
                        <input asp-for="Modelo" class="form-control" maxlength="50" />
                        <span asp-validation-for="Modelo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Anio" class="form-label">Año *</label>
                        <input asp-for="Anio" type="number" min="1900" max="2100" class="form-control" />
                        <span asp-validation-for="Anio" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Kilometraje" class="form-label">Kilometraje *</label>
                        <input asp-for="Kilometraje" type="number" min="0" class="form-control" />
                        <span asp-validation-for="Kilometraje" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Color" class="form-label">Color</label>
                        <input asp-for="Color" class="form-control" maxlength="30" />
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Imagen))
            {
                <div class="form-group mb-3">
                    <label class="form-label">Imagen actual:</label><br />
                    <img src="@Model.Imagen" alt="Vehículo" style="max-width:200px;" class="rounded border" />
                </div>
            }

            <div class="form-group mb-3">
                <label class="form-label">📷 Cambiar imagen</label>
                <input type="file" name="imagen" class="form-control" accept="image/*" />
            </div>

            <div class="form-check mb-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label">Activo</label>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-warning">💾 Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            initSelect2('#clienteSelect', '@Url.Action("BuscarClientes", "Vehiculos")', 'Buscar cliente...');
        });
    </script>
}