@model AutoGest.Models.Vehiculo
@{ ViewData["Title"] = "Eliminar Vehículo"; }

<h1>🗑️ Eliminar Vehículo</h1>
<h3>¿Está seguro de que desea eliminar este vehículo?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Patente</dt><dd class="col-sm-10">@Model.Patente</dd>
        <dt class="col-sm-2">Marca</dt><dd class="col-sm-10">@Model.Marca</dd>
        <dt class="col-sm-2">Modelo</dt><dd class="col-sm-10">@Model.Modelo</dd>
        <dt class="col-sm-2">Año</dt><dd class="col-sm-10">@Model.Anio</dd>
    </dl>

    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Atención:</strong> Si el vehículo tiene órdenes asociadas, la eliminación podría fallar.
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>