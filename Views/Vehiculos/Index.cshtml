@model IEnumerable<AutoGest.Models.Vehiculo>
@{ ViewData["Title"] = "Vehículos"; }

<h1>🚗 Vehículos</h1>

@if (ViewBag.TituloEspecial != null)
{
    <div class="alert alert-info">
        <i class="fas fa-filter"></i> @ViewBag.TituloEspecial
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">Ver todos</a>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Crear Nuevo Vehículo</a>
</p>

<form method="get" class="mb-4">
    <input type="hidden" name="clienteId" value="@ViewBag.ClienteId" />
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Buscar por patente, marca o modelo..." value="@ViewBag.Search">
        <button type="submit" class="btn btn-outline-primary">🔍 Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a href="@Url.Action("Index", new { clienteId = ViewBag.ClienteId })" class="btn btn-outline-secondary">🔄 Limpiar</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron vehículos.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Imagen</th>
                    <th>Patente</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Año</th>
                    <th>Km</th>
                    <th>Cliente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Imagen))
                            {
                                <img src="@item.Imagen" alt="Vehículo" style="width:60px;height:40px;object-fit:cover;" class="rounded" />
                            }
                            else
                            {
                                <span class="text-muted">Sin foto</span>
                            }
                        </td>
                        <td><strong>@item.Patente</strong></td>
                        <td>@item.Marca</td>
                        <td>@item.Modelo</td>
                        <td>@item.Anio</td>
                        <td>@item.Kilometraje.ToString("N0")</td>
                        <td>@(item.Cliente?.NombreCompleto ?? "—")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">👁️</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i, search = ViewBag.Search, clienteId = ViewBag.ClienteId })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}