@model IEnumerable<AutoGest.Models.OrdenReparacion>
@{ ViewData["Title"] = "Órdenes de Reparación"; }

<h1>📋 Órdenes de Reparación</h1>
<p><a asp-action="Create" class="btn btn-primary">➕ Nueva Orden</a></p>

<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Buscar por patente, marca o descripción..." value="@ViewBag.Search">
                <button type="submit" class="btn btn-outline-primary">🔍 Buscar</button>
            </div>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="Pendiente" selected="@(ViewBag.Estado == "Pendiente")">Pendiente</option>
                <option value="En Reparación" selected="@(ViewBag.Estado == "En Reparación")">En Reparación</option>
                <option value="Terminado" selected="@(ViewBag.Estado == "Terminado")">Terminado</option>
                <option value="Entregado" selected="@(ViewBag.Estado == "Entregado")">Entregado</option>
            </select>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">🔄 Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron órdenes.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Vehículo</th>
                    <th>Mecánico</th>
                    <th>Ingreso</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Estado switch
                    {
                        "Pendiente" => "bg-secondary",
                        "En Reparación" => "bg-warning text-dark",
                        "Terminado" => "bg-info text-dark",
                        "Entregado" => "bg-success",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td>@(item.Vehiculo?.Descripcion ?? "—")</td>
                        <td>@(item.Mecanico?.NombreCompleto ?? "—")</td>
                        <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @badgeClass">@item.Estado</span></td>
                        <td>$@item.MontoTotal.ToString("N2")</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">👁️</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { pagina = i, search = ViewBag.Search, estado = ViewBag.Estado })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}