@model AutoGest.Models.OrdenReparacion
@{ ViewData["Title"] = "Editar Orden"; }

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>✏️ Editar Orden #@Model.Id</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FechaCreacion" />
                <input type="hidden" asp-for="UsuarioCreacionId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="VehiculoId" class="form-label fw-bold">🚗 Vehículo *</label>
                                    <select asp-for="VehiculoId" class="form-select" id="vehiculoSelect">
                                        @if (Model.Vehiculo != null)
                                        {
                                            <option value="@Model.Vehiculo.Id" selected>@Model.Vehiculo.Descripcion</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="MecanicoId" class="form-label fw-bold">🔧 Mecánico *</label>
                                    <select asp-for="MecanicoId" class="form-select" id="mecanicoSelect">
                                        @if (Model.Mecanico != null)
                                        {
                                            <option value="@Model.Mecanico.Id" selected>@Model.Mecanico.NombreCompleto</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaIngreso" class="form-label fw-bold">📅 Fecha de Ingreso *</label>
                                    <input asp-for="FechaIngreso" type="date" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaEgreso" class="form-label fw-bold">📅 Fecha de Egreso</label>
                                    <input asp-for="FechaEgreso" type="date" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Estado" class="form-label fw-bold">Estado</label>
                                    <select asp-for="Estado" class="form-select">
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="En Reparación">En Reparación</option>
                                        <option value="Terminado">Terminado</option>
                                        <option value="Entregado">Entregado</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Descripcion" class="form-label fw-bold">📝 Descripción *</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ManoDeObra" class="form-label fw-bold">💰 Mano de obra ($)</label>
                                    <input asp-for="ManoDeObra" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="MontoTotal" class="form-label fw-bold">💵 Monto Total ($)</label>
                                    <input asp-for="MontoTotal" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-warning btn-lg">💾 Guardar</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            initSelect2('#vehiculoSelect', '@Url.Action("BuscarVehiculos", "Ordenes")', 'Buscar vehículo...');
            initSelect2('#mecanicoSelect', '@Url.Action("BuscarMecanicos", "Ordenes")', 'Buscar mecánico...');
        });
    </script>
}